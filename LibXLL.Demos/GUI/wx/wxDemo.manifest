<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3"
          manifestVersion="1.0">

  <!-- Activate Common Controls Library v6 (themed widgets) -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <!-- UAC: run with the invoker's token, no UI automation access.
       MSVC normally injects this via its auto-generated manifest; since we
       suppress that with /MANIFEST:NO we must include it here ourselves. -->
  <asmv3:trustInfo>
    <asmv3:security>
      <asmv3:requestedPrivileges>
        <asmv3:requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </asmv3:requestedPrivileges>
    </asmv3:security>
  </asmv3:trustInfo>

  <!-- DPI awareness:
       - dpiAware  "True/PM"      : legacy declaration for Windows Vista – 8.1
       - dpiAwareness PerMonitorV2: modern declaration for Windows 10 1703+
       When both are present Windows picks the newer one on modern systems
       and falls back to the legacy one on older systems.
       wxWidgets 3.x handles per-monitor DPI changes internally once the OS
       opts the process into PerMonitorV2 mode. -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">True/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

</assembly>

