<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="xlCOMTab" label="xlCOM">
        <group id="xlCOMGroup" label="xlCOM">
          <button id="xlCOMButton"
                  label="Click Me"
                  size="large"
                  getImage="GetButtonImage"
                  onAction="OnButtonClicked" />
          <button id="xlCOMTaskPaneButton"
                  label="Open Task Pane"
                  size="large"
                  onAction="OnTaskPaneClicked" />
          <button id="xlCOMDemoButton"
                  label="ImGui Demo"
                  size="large"
                  imageMso="HappyFace"
                  onAction="OnDemoWindowClicked" />
          <button id="xlCOMDemoButton2"
                  label="ImGui Demo 2"
                  size="large"
                  imageMso="HappyFace"
                  onAction="OnDemoWindow2Clicked" />
        </group>
      </tab>
    </tabs>
  </ribbon>
  <contextMenus>
    <contextMenu idMso="ContextMenuCell">
      <button id="xlCOMContextMenuButton"
              label="xlCOM: Show Message"
              onAction="OnContextMenuClicked"
              insertBeforeMso="Cut" />
    </contextMenu>
  </contextMenus>
</customUI>
