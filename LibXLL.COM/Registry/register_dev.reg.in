Windows Registry Editor Version 5.00

; -----------------------------------------------------------------------
; xlCOM development registration
; Auto-generated by CMake — edit Registry/register_dev.reg.in, not this file.
; Double-click to import.  No administrator rights required.
; Uses HKCU\Software\Classes instead of HKCR so the entries are
; per-user and Windows merges them transparently into HKCR at runtime.
; -----------------------------------------------------------------------

; --- COM class (InprocServer32) -----------------------------------------

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_CONNECT_GUID@}]
@="xlCOM Connect"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_CONNECT_GUID@}\InprocServer32]
@="@XLCOM_DLL_PATH_REG@"
"ThreadingModel"="Apartment"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_CONNECT_GUID@}\ProgID]
@="xlCOM.Connect"

; --- ProgID → CLSID mapping ---------------------------------------------

[HKEY_CURRENT_USER\Software\Classes\xlCOM.Connect]
@="xlCOM Connect"

[HKEY_CURRENT_USER\Software\Classes\xlCOM.Connect\CLSID]
@="{@XLCOM_CONNECT_GUID@}"

; --- Excel COM Add-in entry ---------------------------------------------
; LoadBehavior 3 = Connected + Load at Startup

[HKEY_CURRENT_USER\Software\Microsoft\Office\Excel\Addins\xlCOM.Connect]
"FriendlyName"="xlCOM"
"Description"="xlCOM Excel COM Add-in sample"
"LoadBehavior"=dword:00000003

; --- TaskPaneControl ActiveX (for custom task panes) --------------------

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_TASKPANE_GUID@}]
@="xlCOM TaskPaneControl"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_TASKPANE_GUID@}\InprocServer32]
@="@XLCOM_DLL_PATH_REG@"
"ThreadingModel"="Apartment"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_TASKPANE_GUID@}\Control]

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_TASKPANE_GUID@}\ProgID]
@="xlCOM.TaskPaneCtrl"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{@XLCOM_TASKPANE_GUID@}\Implemented Categories\{40FC6ED4-2438-11CF-A3DB-080036F12502}]

[HKEY_CURRENT_USER\Software\Classes\xlCOM.TaskPaneCtrl]
@="xlCOM TaskPaneControl"

[HKEY_CURRENT_USER\Software\Classes\xlCOM.TaskPaneCtrl\CLSID]
@="{@XLCOM_TASKPANE_GUID@}"

